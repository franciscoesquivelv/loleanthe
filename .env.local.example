# Copiar a .env.local y completar con los valores reales. Ninguno de los
# valores de este archivo es real, .env.local nunca se sube al repo.

# Firebase (Firebase Console → Configuración del proyecto → tus apps → SDK).
# Verificá que ninguno tenga un salto de línea o espacio pegado al final: ya
# rompió Firestore y Storage dos veces sin dar ningún error en consola
# (ver AGENTS copy/memory/loleanthe-firebase-newline-bug si existe, o el
# `trim()` en lib/firebase.ts).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Aviso por correo de cada solicitud de cotización (app/api/notificar-solicitud).
# Cuenta gratuita creada directo en resend.com, NO por el Marketplace de
# Vercel (ese solo ofrece planes desde $20/mes). Sin estas dos, la ruta
# responde 503 y el sitio sigue funcionando igual, solo sin el aviso.
RESEND_API_KEY=
NOTIFICACION_EMAIL=

# Opcional. Remitente del aviso; por defecto usa onboarding@resend.dev, que
# solo entrega a la dirección con la que se creó la cuenta de Resend. Cuando
# loleanthe.com esté verificado en Resend, algo como "Loleanthe <hola@loleanthe.com>".
NOTIFICACION_REMITENTE=
