rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Cualquier usuario autenticado en Firebase Auth = admin.
    // El registro está cerrado, así que solo el equipo de Loleanthe tiene cuenta.
    // MÁS RIGUROSO (a futuro): usar custom claims →
    //   return request.auth != null && request.auth.token.admin == true;
    function isAdmin() {
      return request.auth != null;
    }

    // ── flowers (catálogo público) ───────────────────────────────
    match /flowers/{flowerId} {
      // Lectura pública del catálogo.
      allow read: if true;

      // Solo admin crea/edita, con validación de forma.
      allow create, update: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 5000
        && request.resource.data.inStock is bool
        && request.resource.data.archived is bool
        && request.resource.data.images is list
        && request.resource.data.images.size() <= 20;

      allow delete: if isAdmin();
    }

    // ── inquiries (solicitudes de cotización) ────────────────────
    match /inquiries/{inquiryId} {
      // Solo admin lee/edita/borra (protege la PII de los clientes).
      allow read, update, delete: if isAdmin();

      // Cualquiera CREA una cotización, pero con validación estricta de
      // campos, tipos y longitudes para frenar spam y payloads gigantes.
      // NOTA: cuando actives Firebase App Check, añade `request.app != null &&`
      // al inicio de esta condición para bloquear bots automatizados.
      allow create: if
        request.resource.data.keys().hasOnly(
             ['name', 'email', 'phone', 'buyerType', 'volume', 'message', 'flowers', 'createdAt', 'status'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.email.size() <= 200
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 30
        // El formulario de contacto no manda buyerType ni volume; el de
        // cotización sí. `get` con valor por defecto acepta los dos casos.
        && request.resource.data.get('buyerType', '') is string
        && request.resource.data.get('buyerType', '').size() <= 60
        && request.resource.data.get('volume', '') is string
        && request.resource.data.get('volume', '').size() <= 60
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 2000
        && request.resource.data.flowers is list
        && request.resource.data.flowers.size() <= 50
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
    }

    // ── priceSheets (hoja de precios / oferta) ────────────────────
    // Un documento por temporada. `/precios`, `/precios-cr` y `/precios-gt`
    // leen la que tenga status == 'published' (filtrado en el servidor, no
    // acá: Firestore Rules no puede exigir "que no haya otra publicada").
    // Esa regla de negocio, un solo published a la vez, la aplica la acción
    // Publicar del admin (lib/priceSheets.ts), no estas reglas.
    match /priceSheets/{sheetId} {
      // Lectura pública: la consumen las tres rutas sin login.
      allow read: if true;

      // Solo admin crea/edita, con validación de forma. No valida cada
      // campo de cada ítem de `items` (mismo criterio que ya usa el array
      // `flowers` de `inquiries` más abajo): revisar 60 ítems campo por
      // campo en reglas es costoso y frágil ante el próximo campo nuevo.
      allow create, update: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.dateStart is string
        && request.resource.data.dateStart.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.dateEnd is string
        && request.resource.data.dateEnd.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000
        && request.resource.data.status in ['draft', 'published', 'archived']
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 60;

      // No se puede borrar una hoja publicada: primero hay que publicar
      // otra (que archiva esta sola) o pasarla a archived a mano.
      allow delete: if isAdmin() && resource.data.status != 'published';
    }

    // ── _meta/storage (contador de cuota) ────────────────────────
    // Lectura pública OK (la UI lo muestra). Escritura SOLO admin
    // para que nadie manipule el contador y rompa el límite de Storage.
    match /_meta/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Denegar todo lo demás explícitamente.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
